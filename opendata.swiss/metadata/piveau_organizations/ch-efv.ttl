@prefix dcat: <http://www.w3.org/ns/dcat#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix org: <http://www.w3.org/ns/org#> .
@prefix schema1: <http://schema.org/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix vcard: <http://www.w3.org/2006/vcard/ns#> .

<https://opendata.swiss/id/organization/ch-efv> a org:Organization,
        foaf:Organization ;
    dcterms:identifier "CH_EFV" ;
    dcterms:spatial "CH" ;
    schema1:identifier "CHE145202776" ;
    skos:prefLabel "EFV"@de,
        "FFA"@en,
        "AFF"@fr,
        "AFF"@it ;
    dcat:contactPoint [ a vcard:Organization ;
            vcard:hasAddress "Bundesgasse 3, 3011 Bern, BE"@de,
                "Bundesgasse 3, 3011 Bern, BE"@en,
                "Bundesgasse 3, 3011 Bern, BE"@fr,
                "Bundesgasse 3, 3011 Bern, BE"@it ;
            vcard:hasEmail <mailto:info@efv.admin.ch> ;
            vcard:hasTelephone "+41 584 62 21 11" ] ;
    org:classification <https://register.ld.admin.ch/i14y/concept/legalForm/0220> ;
    org:hasSubOrganization <https://opendata.swiss/id/organization/ch-zas> ;
    org:subOrganizationOf <https://opendata.swiss/id/organization/ch-efd> ;
    foaf:name "Eidgenössische Finanzverwaltung (EFV)"@de,
        "Federal Finance Administration (FFA)"@en,
        "Administration fédérale des finances (AFF)"@fr,
        "Amministrazione federale delle finanze (AFF)"@it .

