<https://opendata.swiss/id/organization/ch-kt-zh-bd-awel> a org:Organization,
        foaf:Organization ;
    dcterms:description "Das Amt für Abfall, Wasser, Energie und Luft (AWEL) des Kantons Zürich hat den Auftrag, der Bevölkerung im Kanton Zürich eine gesunde, sichere und attraktive Umwelt zu bieten. Zu den Themen Abfall, Wasser, Energie und Luft stellt das AWEL Fachleuten und Interessierten Informationen zur Verfügung."@de ;
    dcterms:identifier "CH_KT_ZH_BD_AWEL" ;
    dcterms:spatial "ZH" ;
    schema1:identifier "CHE472555144" ;
    schema1:image <https://input-backend.i14y.c.bfs.admin.ch/api/Media/logo_kt_zh.png> ;
    skos:prefLabel "AWEL (ZH)"@de ;
    dcat:contactPoint [ a vcard:Organization ;
            vcard:hasAddress "ZH, 8001, Zürich, ZH"@de,
                "ZH, 8001, Zürich, ZH"@en,
                "ZH, 8001, Zürich, ZH"@fr,
                "ZH, 8001, Zürich, ZH"@it ;
            vcard:hasEmail <mailto:awel@bd.zh.ch> ;
            vcard:hasTelephone "+41 43 259 32 02" ] ;
    org:classification <https://register.ld.admin.ch/i14y/concept/legalForm/0221> ;
    org:subOrganizationOf <https://opendata.swiss/id/organization/ch-kt-zh-bd-are> ;
    foaf:homepage <https://www.zh.ch/awel> ;
    foaf:name "Amt für Abfall, Wasser, Energie und Luft (ZH)"@de .

<https://www.zh.ch/awel> a foaf:Document .

