@prefix dcat: <http://www.w3.org/ns/dcat#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix org: <http://www.w3.org/ns/org#> .
@prefix schema1: <http://schema.org/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix vcard: <http://www.w3.org/2006/vcard/ns#> .

<https://opendata.swiss/id/organization/ch-kt-zh-g> a org:Organization,
        foaf:Organization ;
    dcterms:description "Die Bevölkerung im Kanton Zürich kann sich auf ein umfassendes Gesundheitswesen verlassen. Es beinhaltet weit mehr als eine hochwertige Spitalversorgung: Wirksame Heilmittel, gesunde Tiere, einwandfreie Lebensmittel und die Qualitätssicherung von Gebrauchsgegenständen gehören ebenso dazu."@de ;
    dcterms:identifier "CH_KT_ZH_G" ;
    dcterms:spatial "ZH" ;
    schema1:image <https://input-backend.i14y.c.bfs.admin.ch/api/Media/logo_kt_zh.png> ;
    skos:prefLabel "Gesundheitsdirektion (ZH)"@de ;
    dcat:contactPoint [ a vcard:Organization ;
            vcard:hasAddress "ZH"@de,
                "ZH"@en,
                "ZH"@fr,
                "ZH"@it ;
            vcard:hasEmail <mailto:generalsekretariat@gd.zh.ch> ;
            vcard:hasTelephone "+41432592405" ] ;
    org:classification <https://register.ld.admin.ch/i14y/concept/legalForm/0221> ;
    foaf:homepage <https://www.zh.ch/de/gesundheitsdirektion.html> ;
    foaf:name "Gesundheitsdirektion (ZH)"@de .

<https://www.zh.ch/de/gesundheitsdirektion.html> a foaf:Document .

