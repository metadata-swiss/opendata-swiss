@prefix dcat: <http://www.w3.org/ns/dcat#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix org: <http://www.w3.org/ns/org#> .
@prefix schema1: <http://schema.org/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix vcard: <http://www.w3.org/2006/vcard/ns#> .

<https://opendata.swiss/id/organization/ch-kt-zh-jus-stat-ogd> a org:Organization,
        foaf:Organization ;
    dcterms:description "Die Fach- und Koordinationsstelle Open Government Data (OGD) ist das kantonale Kompetenzzentrum für offene Behördendaten im Statistischen Amt. Wir unterstützen die Organisationseinheiten und Organe des Kantons bei der Bereitstellung ihrer nicht schützenswerten Daten als Open Data."@de ;
    dcterms:identifier "CH_KT_ZH_JUS_STAT_OGD" ;
    dcterms:spatial "ZH" ;
    schema1:image <https://input-backend.i14y.c.bfs.admin.ch/api/Media/logo_kt_zh.png> ;
    skos:prefLabel "OGD (ZH)"@de ;
    dcat:contactPoint [ a vcard:Organization ;
            vcard:hasAddress "ZH"@de,
                "ZH"@en,
                "ZH"@fr,
                "ZH"@it ;
            vcard:hasEmail <mailto:info@open.zh.ch> ;
            vcard:hasTelephone " +41 43 259 75 55" ] ;
    org:classification <https://register.ld.admin.ch/i14y/concept/legalForm/0221> ;
    org:subOrganizationOf <https://opendata.swiss/id/organization/ch-kt-zh-jus-stat> ;
    foaf:homepage <https://www.zh.ch/de/direktion-der-justiz-und-des-innern/statistisches-amt/open-government-data.html> ;
    foaf:name "Fach- und Koordinationsstelle Open Government Data Kanton Zürich"@de .

<https://www.zh.ch/de/direktion-der-justiz-und-des-innern/statistisches-amt/open-government-data.html> a foaf:Document .

