@prefix dcat: <http://www.w3.org/ns/dcat#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix org: <http://www.w3.org/ns/org#> .
@prefix schema1: <http://schema.org/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix vcard: <http://www.w3.org/2006/vcard/ns#> .

<https://opendata.swiss/id/organization/ch-gde-bern> a org:Organization,
        foaf:Organization ;
    dcterms:identifier "CH_GDE_BERN" ;
    dcterms:spatial "CH" ;
    schema1:identifier "CHE115140892" ;
    schema1:image <https://input-backend.i14y.c.bfs.admin.ch/api/Media/logo_stadt_bern.jpg> ;
    skos:prefLabel "Stadt Bern"@de,
        "City of Bern"@en,
        "Ville de Berne"@fr,
        "Città di Berna"@it ;
    dcat:contactPoint [ a vcard:Organization ;
            vcard:hasEmail <mailto:info@bern.ch> ] ;
    org:classification <https://register.ld.admin.ch/i14y/concept/legalForm/0223> ;
    foaf:homepage <https://bern.ch> ;
    foaf:name "Stadt Bern"@de,
        "City of Bern"@en,
        "Ville de Berne"@fr,
        "Città di Berna"@it .

<https://bern.ch> a foaf:Document .

