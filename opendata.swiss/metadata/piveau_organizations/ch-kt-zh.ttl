@prefix dcat: <http://www.w3.org/ns/dcat#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix org: <http://www.w3.org/ns/org#> .
@prefix schema1: <http://schema.org/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix vcard: <http://www.w3.org/2006/vcard/ns#> .

<https://opendata.swiss/id/organization/ch-kt-zh> a org:Organization,
        foaf:Organization ;
    dcterms:identifier "CH_KT_ZH" ;
    dcterms:spatial "ZH" ;
    schema1:identifier "CHE114809327" ;
    schema1:image <https://input-backend.i14y.c.bfs.admin.ch/api/Media/logo_kt_zh.png> ;
    skos:prefLabel "ZH"@de,
        "ZH"@en,
        "ZH"@fr,
        "ZH"@it ;
    dcat:contactPoint [ a vcard:Organization ;
            vcard:hasAddress "Neumühlequai 10, 8001, Zürich, ZH"@de,
                "Neumühlequai 10, 8001, Zürich, ZH"@en,
                "Neumühlequai 10, 8001, Zürich, ZH"@fr,
                "Neumühlequai 10, 8001, Zürich, ZH"@it ;
            vcard:hasEmail <mailto:info@zh.ch> ] ;
    org:classification <https://register.ld.admin.ch/i14y/concept/legalForm/0221> ;
    foaf:homepage <https://www.zh.ch> ;
    foaf:name "Kanton Zürich"@de,
        "Canton Zurich"@en,
        "Canton Zurich"@fr,
        "Cantone Zurigo"@it .

<https://www.zh.ch> a foaf:Document .

