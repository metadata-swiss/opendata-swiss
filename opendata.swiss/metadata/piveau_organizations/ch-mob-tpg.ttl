@prefix dcat: <http://www.w3.org/ns/dcat#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix org: <http://www.w3.org/ns/org#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix vcard: <http://www.w3.org/2006/vcard/ns#> .

<https://opendata.swiss/id/organization/ch-mob-tpg> a org:Organization,
        foaf:Organization ;
    dcterms:identifier "CH_MOB_TPG" ;
    skos:prefLabel "Transports publics genevois TPG (GE)"@de,
        "Transports publics genevois TPG (GE)"@fr ;
    dcat:contactPoint [ a vcard:Organization ;
            vcard:hasEmail <mailto:info@tpg.ch> ] ;
    foaf:homepage <https://tpg.ch> ;
    foaf:name "Transports publics genevois TPG (GE)"@de,
        "Transports publics genevois TPG (GE)"@fr .

<https://tpg.ch> a foaf:Document .

