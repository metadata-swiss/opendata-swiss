<https://opendata.swiss/id/organization/ch-kt-zh-s> a org:Organization,
        foaf:Organization ;
    dcterms:description "Sicher, sozial, sportlich. Wir sorgen für die öffentliche Sicherheit. Wir verfolgen eine Sozial- und Ausländerpolitik, die für alle Beteiligten fair ist. Und nicht zuletzt setzen wir uns dafür ein, dass sich möglichst viele Zürcherinnen und Zürcher sportlich aktiv betätigen."@de ;
    dcterms:identifier "CH_KT_ZH_S" ;
    dcterms:spatial "ZH" ;
    schema1:image <https://input-backend.i14y.c.bfs.admin.ch/api/Media/logo_kt_zh.png> ;
    skos:prefLabel "S (ZH)"@de,
        "S (ZH)"@en,
        "S (ZH)"@fr,
        "S (ZH)"@it ;
    dcat:contactPoint [ a vcard:Organization ;
            vcard:hasAddress "ZH"@de,
                "ZH"@en,
                "ZH"@fr,
                "ZH"@it ;
            vcard:hasEmail <mailto:ds@ds.zh.ch> ;
            vcard:hasTelephone "+41432591111" ] ;
    org:classification <https://register.ld.admin.ch/i14y/concept/legalForm/0220> ;
    foaf:homepage <https://www.zh.ch/ds> ;
    foaf:name "Sicherheitsdirektion (ZH)"@de .

<https://www.zh.ch/ds> a foaf:Document .

