@prefix dcat: <http://www.w3.org/ns/dcat#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix org: <http://www.w3.org/ns/org#> .
@prefix schema1: <http://schema.org/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix vcard: <http://www.w3.org/2006/vcard/ns#> .

<https://opendata.swiss/id/organization/ch-kt-be-parl> a org:Organization,
        foaf:Organization ;
    dcterms:description "Die Parlamentsdienste unterstützen den Grossen Rat bei der parlamentarischen Arbeit. Sie sind ihm und seinen Organen verantwortlich und arbeiten nach deren Weisungen."@de,
        "Les Services parlementaires assistent le Grand Conseil dans son travail. Ils lui rendent compte ainsi qu’à ses organes et travaillent selon leurs instructions."@fr ;
    dcterms:identifier "CH_KT_BE_PARL" ;
    dcterms:spatial "BE" ;
    schema1:image <https://input-backend.i14y.c.bfs.admin.ch/api/Media/Kanton_Bern_RGB.jpg> ;
    skos:prefLabel "PARL (BE)"@de,
        "PARL (BE)"@fr ;
    dcat:contactPoint [ a vcard:Organization ;
            vcard:hasAddress "Postgasse 68, 3000, Bern 8, BE"@de,
                "Postgasse 68, 3000, Bern 8, BE"@en,
                "Postgasse 68, 3000, Bern 8, BE"@fr,
                "Postgasse 68, 3000, Bern 8, BE"@it ;
            vcard:hasEmail <mailto:gr-gc@be.ch> ;
            vcard:hasTelephone "+41 31 633 75 75" ] ;
    org:classification <https://register.ld.admin.ch/i14y/concept/legalForm/0221> ;
    foaf:homepage <https://www.gr.be.ch/de/start/parlamentsdienste.html> ;
    foaf:name "Parlamentsdienste (BE)"@de,
        "Services parlementaires (BE)"@fr .

<https://www.gr.be.ch/de/start/parlamentsdienste.html> a foaf:Document .

