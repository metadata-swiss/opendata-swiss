<https://opendata.swiss/id/organization/ch-kt-zh-fin-fin> a org:Organization,
        foaf:Organization ;
    dcterms:description "Die Finanzverwaltung ist unter anderem verantwortlich für den Konsolidierten Entwicklungs- und Finanzplan (KEF) und fungiert als finanzielle Schnittstelle zum Bund und zu den Kantonen."@de ;
    dcterms:identifier "CH_KT_ZH_FIN_FIN" ;
    dcterms:spatial "ZH" ;
    schema1:identifier "CHE288438891" ;
    schema1:image <https://input-backend.i14y.c.bfs.admin.ch/api/Media/logo_kt_zh.png> ;
    skos:prefLabel "Finanzverwaltung (ZH)"@de ;
    dcat:contactPoint [ a vcard:Organization ;
            vcard:hasAddress "Walcheplatz 1, 8001, Zürich, ZH"@de,
                "Walcheplatz 1, 8001, Zürich, ZH"@en,
                "Walcheplatz 1, 8001, Zürich, ZH"@fr,
                "Walcheplatz 1, 8001, Zürich, ZH"@it ;
            vcard:hasEmail <mailto:info.fv@zh.ch> ;
            vcard:hasTelephone "+41 432 59 33 33" ] ;
    org:classification <https://register.ld.admin.ch/i14y/concept/legalForm/0221> ;
    foaf:homepage <https://www.zh.ch/de/finanzdirektion/finanzverwaltung.html> ;
    foaf:name "Finanzverwaltung (ZH)"@de .

