@prefix dcat: <http://www.w3.org/ns/dcat#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix org: <http://www.w3.org/ns/org#> .
@prefix schema1: <http://schema.org/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix vcard: <http://www.w3.org/2006/vcard/ns#> .

<https://opendata.swiss/id/organization/ch-kt-be-dsb> a org:Organization,
        foaf:Organization ;
    dcterms:description "Als unabhängige Fachstelle beraten und beaufsichtigen wir kantonale und kommunale Behörden in Datenschutzfragen."@de,
        "En tant qu'organisme spécialisé indépendant, nous conseillons et supervisons les autorités cantonales et communales en matière de protection des données."@fr ;
    dcterms:identifier "CH_KT_BE_DSB" ;
    dcterms:spatial "BE" ;
    schema1:image <https://input-backend.i14y.c.bfs.admin.ch/api/Media/Kanton_Bern_RGB.jpg> ;
    skos:prefLabel "DSB (BE)"@de,
        "BPD (BE)"@fr ;
    dcat:contactPoint [ a vcard:Organization ;
            vcard:hasAddress "Poststrasse 25, 3072, Ostermundigen, BE"@de,
                "Poststrasse 25, 3072, Ostermundigen, BE"@en,
                "Poststrasse 25, 3072, Ostermundigen, BE"@fr,
                "Poststrasse 25, 3072, Ostermundigen, BE"@it ;
            vcard:hasEmail <mailto:datenschutz@be.ch> ] ;
    org:classification <https://register.ld.admin.ch/i14y/concept/legalForm/0221> ;
    foaf:homepage <https://www.dsa.be.ch> ;
    foaf:name "Datenschutzbehörde (BE)"@de,
        "Bureau pour la protection des données (BE)"@fr .

<https://www.dsa.be.ch> a foaf:Document .

