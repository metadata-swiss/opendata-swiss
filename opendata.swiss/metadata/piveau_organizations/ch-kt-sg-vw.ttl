@prefix dcat: <http://www.w3.org/ns/dcat#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix org: <http://www.w3.org/ns/org#> .
@prefix schema1: <http://schema.org/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix vcard: <http://www.w3.org/2006/vcard/ns#> .

<https://opendata.swiss/id/organization/ch-kt-sg-vw> a org:Organization,
        foaf:Organization ;
    dcterms:identifier "CH_KT_SG_VW" ;
    dcterms:spatial "SG" ;
    schema1:image <https://input-backend.i14y.c.bfs.admin.ch/api/Media/logo_sg.jpg> ;
    skos:prefLabel "Volkswirtschaft (SG)"@de ;
    dcat:contactPoint [ a vcard:Organization ;
            vcard:hasAddress " Davidstrasse 35, 9001, St.Gallen, SG"@de,
                " Davidstrasse 35, 9001, St.Gallen, SG"@en,
                " Davidstrasse 35, 9001, St.Gallen, SG"@fr,
                " Davidstrasse 35, 9001, St.Gallen, SG"@it ;
            vcard:hasEmail <mailto:info.vdgs@sg.ch> ] ;
    org:classification <https://register.ld.admin.ch/i14y/concept/legalForm/0221> ;
    org:subOrganizationOf <https://opendata.swiss/id/organization/ch-kt-sg> ;
    foaf:name "Volkswirtschaftsdepartement (SG)"@de .

