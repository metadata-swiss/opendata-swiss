@prefix dcat: <http://www.w3.org/ns/dcat#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix org: <http://www.w3.org/ns/org#> .
@prefix schema1: <http://schema.org/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix vcard: <http://www.w3.org/2006/vcard/ns#> .

<https://opendata.swiss/id/organization/ch-wbf-gs-wbf> a org:Organization,
        foaf:Organization ;
    dcterms:identifier "CH_WBF_GS-WBF" ;
    dcterms:spatial "CH" ;
    schema1:image <https://input-backend.i14y.c.bfs.admin.ch/api/Media/logo_ch.png> ;
    skos:prefLabel "GS-WBF"@de,
        "GS-WBF"@en,
        "GS-WBF"@fr,
        "GS-WBF"@it ;
    dcat:contactPoint [ a vcard:Organization ;
            vcard:hasAddress "Kochergasse 9, 3003, Bern, BE"@de,
                "Kochergasse 9, 3003, Bern, BE"@en,
                "Kochergasse 9, 3003, Bern, BE"@fr,
                "Kochergasse 9, 3003, Bern, BE"@it ;
            vcard:hasEmail <mailto:info@wbf.admin.ch> ] ;
    org:classification <https://register.ld.admin.ch/i14y/concept/legalForm/0220> ;
    org:hasSubOrganization <https://opendata.swiss/id/organization/ch-wbf-gs-wbf-isceco> ;
    org:subOrganizationOf <https://opendata.swiss/id/organization/ch-wbf> ;
    foaf:name "Generalsekretariat WBF"@de,
        "Secrétariat général du DEFR"@fr,
        "Segreteria generale DEFR"@it .

