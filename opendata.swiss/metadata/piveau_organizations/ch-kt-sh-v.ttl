@prefix dcat: <http://www.w3.org/ns/dcat#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix org: <http://www.w3.org/ns/org#> .
@prefix schema1: <http://schema.org/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix vcard: <http://www.w3.org/2006/vcard/ns#> .

<https://opendata.swiss/id/organization/ch-kt-sh-v> a org:Organization,
        foaf:Organization ;
    dcterms:identifier "CH_KT_SH_V" ;
    dcterms:spatial "SH" ;
    schema1:image <https://input-backend.i14y.c.bfs.admin.ch/api/Media/logo_SH.jpg> ;
    skos:prefLabel "Volkswirtschaftsdirektion (SH)"@de ;
    dcat:contactPoint [ a vcard:Organization ;
            vcard:hasEmail <mailto:sekretariat.vd@sh.ch> ] ;
    org:classification <https://register.ld.admin.ch/i14y/concept/legalForm/0221> ;
    org:hasSubOrganization <https://opendata.swiss/id/organization/ch-kt-sh-v-geo> ;
    org:subOrganizationOf <https://opendata.swiss/id/organization/ch-kt-sh> ;
    foaf:name "Volkswirtschaftsdirektion des Kantons Schaffhausen"@de .

