@prefix dcat: <http://www.w3.org/ns/dcat#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix org: <http://www.w3.org/ns/org#> .
@prefix schema1: <http://schema.org/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix vcard: <http://www.w3.org/2006/vcard/ns#> .

<https://opendata.swiss/id/organization/ch-kt-ag-fin-inf> a org:Organization,
        foaf:Organization ;
    dcterms:identifier "CH_KT_AG_FIN_INF" ;
    dcterms:spatial "AG" ;
    schema1:image <https://input-backend.i14y.c.bfs.admin.ch/api/Media/logo_AG.png> ;
    skos:prefLabel "Informatik (AG)"@de ;
    dcat:contactPoint [ a vcard:Organization ;
            vcard:hasAddress "AG"@de,
                "AG"@en,
                "AG"@fr,
                "AG"@it ;
            vcard:hasEmail <mailto:itag@ag.ch> ] ;
    org:classification <https://register.ld.admin.ch/i14y/concept/legalForm/0221> ;
    org:subOrganizationOf <https://opendata.swiss/id/organization/ch-kt-ag-fin> ;
    foaf:name "Informatik (AG)"@de .

