@prefix schema1: <http://schema.org/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix vcard: <http://www.w3.org/2006/vcard/ns#> .

<https://opendata.swiss/id/organization/ch-kt-bern> a org:Organization,
        foaf:Organization ;
    dcterms:identifier "CH_KT_BERN" ;
    dcterms:spatial "BE" ;
    schema1:identifier "CHE114809379" ;
    schema1:image <https://input-backend.i14y.c.bfs.admin.ch/api/Media/Kanton_Bern_RGB.jpg> ;
    skos:prefLabel "Kanton Bern"@de,
        "Canton Berne"@fr ;
    dcat:contactPoint [ a vcard:Organization ;
            vcard:hasAddress "Postgasse 68, 3011, Bern, BE"@de,
                "Postgasse 68, 3011, Bern, BE"@en,
                "Postgasse 68, 3011, Bern, BE"@fr,
                "Postgasse 68, 3011, Bern, BE"@it ;
            vcard:hasEmail <mailto:info@be.ch> ] ;
    org:classification <https://register.ld.admin.ch/i14y/concept/legalForm/0221> ;
    foaf:homepage <https://www.be.ch> ;
    foaf:name "Kanton Bern"@de,
        "Canton Berne"@fr .

<https://www.be.ch> a foaf:Document .

