@prefix vcard: <http://www.w3.org/2006/vcard/ns#> .

<https://opendata.swiss/id/organization/ch-blw> a org:Organization,
        foaf:Organization ;
    dcterms:identifier "CH_BLW" ;
    dcterms:spatial "CH" ;
    schema1:identifier "CHE146680598" ;
    skos:prefLabel "BLW"@de,
        "FOAG"@en,
        "OFAG"@fr,
        "UFAG"@it ;
    dcat:contactPoint [ a vcard:Organization ;
            vcard:hasAddress "Schwarzenburgstrasse 165, 3003 Bern, BE"@de,
                "Schwarzenburgstrasse 165, 3003 Bern, BE"@en,
                "Schwarzenburgstrasse 165, 3003 Bern, BE"@fr,
                "Schwarzenburgstrasse 165, 3003 Bern, BE"@it,
                "Schwarzenburgstrasse 165, 3003 Bern, BE"@rm ;
            vcard:hasEmail <mailto:info@blw.admin.ch> ] ;
    org:classification <https://register.ld.admin.ch/i14y/concept/legalForm/0220> ;
    org:hasSubOrganization <https://opendata.swiss/id/organization/ch-agroscope> ;
    org:subOrganizationOf <https://opendata.swiss/id/organization/ch-wbf> ;
    foaf:homepage <https://blw.admin.ch> ;
