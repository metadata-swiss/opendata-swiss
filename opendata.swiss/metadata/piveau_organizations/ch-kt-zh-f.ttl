@prefix dcat: <http://www.w3.org/ns/dcat#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix org: <http://www.w3.org/ns/org#> .
@prefix schema1: <http://schema.org/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix vcard: <http://www.w3.org/2006/vcard/ns#> .

<https://opendata.swiss/id/organization/ch-kt-zh-f> a org:Organization,
        foaf:Organization ;
    dcterms:description "Die Finanzdirektion des Kantons Zürich legt ihren Fokus auf gesunde und starke Staatsfinanzen, aber auch auf eine moderate Steuerbelastung für die Bevölkerung und die Wirtschaft."@de ;
    dcterms:identifier "CH_KT_ZH_F" ;
    dcterms:spatial "ZH" ;
    schema1:image <https://input-backend.i14y.c.bfs.admin.ch/api/Media/logo_kt_zh.png> ;
    skos:prefLabel "Finanzdirektion (ZH)"@de ;
    dcat:contactPoint [ a vcard:Organization ;
            vcard:hasAddress "Zurich, ZH"@de,
                "Zurich, ZH"@en,
                "Zurich, ZH"@fr,
                "Zurich, ZH"@it ;
            vcard:hasEmail <mailto:generalsekretariat-fd@zh.ch> ;
            vcard:hasTelephone "+41432591111" ] ;
    org:classification <https://register.ld.admin.ch/i14y/concept/legalForm/0221> ;
    foaf:homepage <https://www.zh.ch/de/finanzdirektion.html> ;
    foaf:name "Finanzdirektion (ZH)"@de .

<https://www.zh.ch/de/finanzdirektion.html> a foaf:Document .

