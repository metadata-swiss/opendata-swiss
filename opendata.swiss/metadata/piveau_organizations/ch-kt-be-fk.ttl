@prefix vcard: <http://www.w3.org/2006/vcard/ns#> .

<https://opendata.swiss/id/organization/ch-kt-be-fk> a org:Organization,
        foaf:Organization ;
    dcterms:identifier "CH_KT_BE_FK" ;
    dcterms:spatial "BE" ;
    schema1:identifier "CHE113941007" ;
    schema1:image <https://input-backend.i14y.c.bfs.admin.ch/api/Media/Kanton_Bern_RGB.jpg> ;
    skos:prefLabel "FK (BE)"@de,
        "CF (BE)"@fr ;
    dcat:contactPoint [ a vcard:Organization ;
            vcard:hasAddress "Schermenweg 5, 3014, Bern, BE"@de,
                "Schermenweg 5, 3014, Bern, BE"@en,
                "Schermenweg 5, 3014, Bern, BE"@fr,
                "Schermenweg 5, 3014, Bern, BE"@it ;
            vcard:hasEmail <mailto:info.fk@be.ch> ;
            vcard:hasTelephone "+41 31 636 02 00" ] ;
    org:classification <https://register.ld.admin.ch/i14y/concept/legalForm/0221> ;
    foaf:homepage <https://www.finanzkontrolle.be.ch> ;
    foaf:name "Finanzkontrolle (BE)"@de,
        "Contrôle des finances (BE)"@fr .

<https://www.finanzkontrolle.be.ch> a foaf:Document .

