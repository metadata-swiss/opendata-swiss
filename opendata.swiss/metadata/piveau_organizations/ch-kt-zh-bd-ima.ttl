@prefix vcard: <http://www.w3.org/2006/vcard/ns#> .

<https://opendata.swiss/id/organization/ch-kt-zh-bd-ima> a org:Organization,
        foaf:Organization ;
    dcterms:description "Der Kanton Zürich verfügt über eines der grössten Immobilienportfolios der öffentlichen Hand in der Schweiz. Das Immobilienamt ist als Eigentümervertretung des Kantons mit der Steuerung, Entwicklung und Bewirtschaftung dieses Portfolios betraut."@de ;
    dcterms:identifier "CH_KT_ZH_BD_IMA" ;
    dcterms:spatial "ZH" ;
    schema1:identifier "CHE472580248" ;
    schema1:image <https://input-backend.i14y.c.bfs.admin.ch/api/Media/logo_kt_zh.png> ;
    skos:prefLabel "Immobilienamt (ZH)"@de ;
    dcat:contactPoint [ a vcard:Organization ;
            vcard:hasAddress "ZH, ZH, Zürich, ZH"@de,
                "ZH, ZH, Zürich, ZH"@en,
                "ZH, ZH, Zürich, ZH"@fr,
                "ZH, ZH, Zürich, ZH"@it ;
            vcard:hasEmail <mailto:ima@bd.zh.ch> ] ;
    org:classification <https://register.ld.admin.ch/i14y/concept/legalForm/0221> ;
    org:subOrganizationOf <https://opendata.swiss/id/organization/ch-kt-zh-bd> ;
    foaf:homepage <https://www.zh.ch/ima> ;
    foaf:name "Immobilienamt (ZH)"@de .

<https://www.zh.ch/ima> a foaf:Document .

