@prefix vcard: <http://www.w3.org/2006/vcard/ns#> .

<https://opendata.swiss/id/organization/ch-kt-sg-bau> a org:Organization,
        foaf:Organization ;
    dcterms:identifier "CH_KT_SG_BAU" ;
    dcterms:spatial "SG" ;
    schema1:image <https://input-backend.i14y.c.bfs.admin.ch/api/Media/logo_sg.jpg> ;
    skos:prefLabel "Bau- und Umweltdepartement (SG)"@de ;
    dcat:contactPoint [ a vcard:Organization ;
            vcard:hasAddress "Lämmlisbrunnenstrasse 54, 9001, St.Gallen, SG"@de,
                "Lämmlisbrunnenstrasse 54, 9001, St.Gallen, SG"@en,
                "Lämmlisbrunnenstrasse 54, 9001, St.Gallen, SG"@fr,
                "Lämmlisbrunnenstrasse 54, 9001, St.Gallen, SG"@it ;
            vcard:hasEmail <mailto:info.bud@sg.ch> ;
            vcard:hasTelephone "+41582293003" ] ;
    org:classification <https://register.ld.admin.ch/i14y/concept/legalForm/0221> ;
    org:hasSubOrganization <https://opendata.swiss/id/organization/ch-kt-sg-bau-areg> ;
    org:subOrganizationOf <https://opendata.swiss/id/organization/ch-kt-sg> ;
    foaf:name "Bau- und Umweltdepartement (SG)"@de .

