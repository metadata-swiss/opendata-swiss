@prefix dcat: <http://www.w3.org/ns/dcat#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix org: <http://www.w3.org/ns/org#> .
@prefix schema1: <http://schema.org/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix vcard: <http://www.w3.org/2006/vcard/ns#> .

<https://opendata.swiss/id/organization/ch-kt-luzern-immobilien> a org:Organization,
        foaf:Organization ;
    dcterms:description "Die Dienststelle Immobilien ist das Immobilien-Kompetenzzentrum des Kantons Luzern. Sie vertritt als Eigentümerin und Bauherrin die Interessen des Kantons Luzern und betreibt ein innovatives und nachhaltiges Immobilienmanagement."@de ;
    dcterms:identifier "CH_KT_LUZERN_IMMOBILIEN" ;
    dcterms:spatial "LU" ;
    schema1:image <https://input-backend.i14y.c.bfs.admin.ch/api/Media/luzern_logo.png> ;
    skos:prefLabel "Immobilien (LU)"@de,
        "Real Estate (LU)"@en,
        "Immobilier (LU)"@fr,
        "Immobiliare (LU)"@it ;
    dcat:contactPoint [ a vcard:Organization ;
            vcard:hasAddress "Stadthofstrasse 4, 6002, Luzern, LU"@de,
                "Stadthofstrasse 4, 6002, Luzern, LU"@en,
                "Stadthofstrasse 4, 6002, Luzern, LU"@fr,
                "Stadthofstrasse 4, 6002, Luzern, LU"@it ;
            vcard:hasEmail <mailto:immobilien@lu.ch> ;
            vcard:hasTelephone "+41 41 228 51 00" ] ;
    org:classification <https://register.ld.admin.ch/i14y/concept/legalForm/0221> ;
    org:subOrganizationOf <https://opendata.swiss/id/organization/ch-kt-luzern-fd> ;
    foaf:homepage <https://www.immobilien.lu.ch> ;
    foaf:name "Dienststelle Immobilien (LU)"@de,
        "Real Estate Office  (LU)"@en,
        "Service immobilier  (LU)"@fr,
        "Servizio immobiliare  (LU)"@it .

<https://www.immobilien.lu.ch> a foaf:Document .

