    dcterms:spatial "GE" ;
    schema1:identifier "CHE277450215" ;
    schema1:image <https://input-backend.i14y.c.bfs.admin.ch/api/Media/logo_imad2.png> ;
    skos:prefLabel "IMAD"@de,
        "IMAD"@en,
        "IMAD"@fr,
        "IMAD"@it ;
    dcat:contactPoint [ a vcard:Organization ;
            vcard:hasAddress "Esplanade de Pont-Rouge 5, 1212, Grand-Lancy, GE"@de,
                "Esplanade de Pont-Rouge 5, 1212, Grand-Lancy, GE"@en,
                "Esplanade de Pont-Rouge 5, 1212, Grand-Lancy, GE"@fr,
                "Esplanade de Pont-Rouge 5, 1212, Grand-Lancy, GE"@it ;
            vcard:hasEmail <mailto:info@imad-ge.ch> ] ;
