@prefix dcat: <http://www.w3.org/ns/dcat#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix org: <http://www.w3.org/ns/org#> .
@prefix schema1: <http://schema.org/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix vcard: <http://www.w3.org/2006/vcard/ns#> .

<https://opendata.swiss/id/organization/ch-openparldata> a org:Organization,
        foaf:Organization ;
    dcterms:identifier "CH_OPENPARLDATA" ;
    schema1:image <https://input-backend.i14y.c.bfs.admin.ch/api/Media/efk_logo.png> ;
    skos:prefLabel "OpenParlData.ch"@de,
        "OpenParlData.ch"@en,
        "OpenParlData.ch"@fr,
        "OpenParlData.ch"@it ;
    dcat:contactPoint [ a vcard:Organization ;
            vcard:hasEmail <mailto:info@openparldata.ch> ] ;
    org:classification <https://register.ld.admin.ch/i14y/concept/legalForm/0220> ;
    foaf:name "OpenParlData.ch"@de,
        "OpenParlData.ch"@en,
        "OpenParlData.ch"@fr,
        "OpenParlData.ch"@it .

