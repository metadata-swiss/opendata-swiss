@prefix vcard: <http://www.w3.org/2006/vcard/ns#> .

<https://opendata.swiss/id/organization/ch-swisstopo> a org:Organization,
        foaf:Organization ;
    dcterms:identifier "CH_SWISSTOPO" ;
    dcterms:spatial "CH" ;
