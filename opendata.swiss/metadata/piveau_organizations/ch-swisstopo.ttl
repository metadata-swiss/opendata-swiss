        "swisstopo"@fr,
        "swisstopo"@it ;
    dcat:contactPoint [ a vcard:Organization ;
            vcard:hasAddress "Seftigenstrasse 264, 3084 Wabern, BE"@de,
                "Seftigenstrasse 264, 3084 Wabern, BE"@en,
                "Seftigenstrasse 264, 3084 Wabern, BE"@fr,
                "Seftigenstrasse 264, 3084 Wabern, BE"@it,
                "Seftigenstrasse 264, 3084 Wabern, BE"@rm ;
            vcard:hasEmail <mailto:info@swisstopo.ch> ] ;
    org:classification <https://register.ld.admin.ch/i14y/concept/legalForm/0220> ;
    org:subOrganizationOf <https://opendata.swiss/id/organization/ch-vbs> ;
    foaf:homepage <https://www.swisstopo.ch> ;
