@prefix dcat: <http://www.w3.org/ns/dcat#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix org: <http://www.w3.org/ns/org#> .
@prefix schema1: <http://schema.org/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix vcard: <http://www.w3.org/2006/vcard/ns#> .

<https://opendata.swiss/id/organization/ch-kt-be-sta> a org:Organization,
        foaf:Organization ;
    dcterms:identifier "CH_KT_BE_STA" ;
    dcterms:spatial "BE" ;
    schema1:identifier "CHE105620392" ;
    schema1:image <https://input-backend.i14y.c.bfs.admin.ch/api/Media/Kanton_Bern_RGB.jpg> ;
    skos:prefLabel "STA (BE)"@de,
        "CHA (BE)"@fr ;
    dcat:contactPoint [ a vcard:Organization ;
            vcard:hasAddress "Postgasse 68, 3011, Bern, BE"@de,
                "Postgasse 68, 3011, Bern, BE"@en,
                "Postgasse 68, 3011, Bern, BE"@fr,
                "Postgasse 68, 3011, Bern, BE"@it ;
            vcard:hasEmail <mailto:info.sta@be.ch> ;
            vcard:hasTelephone "+41 31 633 75 11" ] ;
    org:classification <https://register.ld.admin.ch/i14y/concept/legalForm/0221> ;
    foaf:homepage <https://www.sta.be.ch> ;
    foaf:name "Staatskanzlei (BE)"@de,
        "Chancellerie d'État (BE)"@fr .

<https://www.sta.be.ch> a foaf:Document .

