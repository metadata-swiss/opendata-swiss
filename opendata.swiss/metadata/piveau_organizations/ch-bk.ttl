@prefix dcat: <http://www.w3.org/ns/dcat#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix org: <http://www.w3.org/ns/org#> .
@prefix schema1: <http://schema.org/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix vcard: <http://www.w3.org/2006/vcard/ns#> .

<https://opendata.swiss/id/organization/ch-bk> a org:Organization,
        foaf:Organization ;
    dcterms:identifier "CH_BK" ;
    dcterms:spatial "CH" ;
    schema1:identifier "CHE263297189" ;
    schema1:image <https://input-backend.i14y.c.bfs.admin.ch/api/Media/logo_ch.png> ;
    skos:prefLabel "BK"@de,
        "CCh"@en,
        "ChF"@fr,
        "CaF"@it ;
    dcat:contactPoint [ a vcard:Organization ;
            vcard:hasAddress "Bundesgasse 1, 3011 Bern, BE"@de,
                "Bundesgasse 1, 3011 Bern, BE"@en,
                "Bundesgasse 1, 3011 Bern, BE"@fr,
                "Bundesgasse 1, 3011 Bern, BE"@it ;
            vcard:hasEmail <mailto:info@bk.admin.ch> ] ;
    org:classification <https://register.ld.admin.ch/i14y/concept/legalForm/0220> ;
    org:hasSubOrganization <https://opendata.swiss/id/organization/ch-bk-dti>,
        <https://opendata.swiss/id/organization/ch-bk-dti-ds> ;
    foaf:name "Schweizerische Bundeskanzlei (BK)"@de,
        "Swiss Federal Chancellery (FCh)"@en,
        "Chancellerie fédérale (ChF)"@fr,
        "Cancelleria federale (CaF)"@it .

