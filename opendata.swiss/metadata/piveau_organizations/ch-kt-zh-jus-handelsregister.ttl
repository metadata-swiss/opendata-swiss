@prefix dcat: <http://www.w3.org/ns/dcat#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix org: <http://www.w3.org/ns/org#> .
@prefix schema1: <http://schema.org/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix vcard: <http://www.w3.org/2006/vcard/ns#> .

<https://opendata.swiss/id/organization/ch-kt-zh-jus-handelsregister> a org:Organization,
        foaf:Organization ;
    dcterms:description "Das Handelsregisteramt ist zuständig für sämtliche Eintragungen betreffend Unternehmen mit Sitz im Kanton Zürich. Durch die Identifikation von Unternehmen und die Offenlegung von rechtlich relevanten Tatsachen gewährleistet es die Transparenz und Rechtssicherheit im Geschäftsverkehr."@de ;
    dcterms:identifier "CH_KT_ZH_JUS_HANDELSREGISTER" ;
    dcterms:spatial "ZH" ;
    schema1:image <https://input-backend.i14y.c.bfs.admin.ch/api/Media/logo_kt_zh.png> ;
    skos:prefLabel "Handelsregisteramt Kanton Zürich"@de ;
    dcat:contactPoint [ a vcard:Organization ;
            vcard:hasAddress "ZH, ZH"@de,
                "ZH, ZH"@en,
                "ZH, ZH"@fr,
                "ZH, ZH"@it ;
            vcard:hasEmail <mailto:mailbox.hra@ji.zh.ch> ;
            vcard:hasTelephone "+41 43 259 74 00" ] ;
    org:classification <https://register.ld.admin.ch/i14y/concept/legalForm/0221> ;
    org:subOrganizationOf <https://opendata.swiss/id/organization/ch-kt-zh-dji> ;
    foaf:homepage <https://www.zh.ch/de/direktion-der-justiz-und-des-innern/handelsregisteramt.html> ;
    foaf:name "Handelsregisteramt Kanton Zürich"@de .

<https://www.zh.ch/de/direktion-der-justiz-und-des-innern/handelsregisteramt.html> a foaf:Document .

