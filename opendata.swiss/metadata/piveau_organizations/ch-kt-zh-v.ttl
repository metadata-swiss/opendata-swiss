<https://opendata.swiss/id/organization/ch-kt-zh-v> a org:Organization,
        foaf:Organization ;
    dcterms:description "Wir fördern und entwickeln den Kanton Zürich als attraktiven Wirtschafts- und Lebensraum und engagieren sich für einen starken Standort mit guten Rahmenbedingungen."@de,
        "Wir fördern und entwickeln den Kanton Zürich als attraktiven Wirtschafts- und Lebensraum und engagieren sich für einen starken Standort mit guten Rahmenbedingungen."@en ;
    dcterms:identifier "CH_KT_ZH_V" ;
    dcterms:spatial "ZH" ;
    schema1:image <https://input-backend.i14y.c.bfs.admin.ch/api/Media/logo_kt_zh.png> ;
    skos:prefLabel "Volkswirtschaftsdirektion (ZH)"@de ;
    dcat:contactPoint [ a vcard:Organization ;
            vcard:hasAddress "ZH"@de,
                "ZH"@en,
                "ZH"@fr,
                "ZH"@it ;
            vcard:hasEmail <mailto:generalsekretariat@vd.zh.ch> ;
            vcard:hasTelephone "+41432592611" ] ;
    org:classification <https://register.ld.admin.ch/i14y/concept/legalForm/0221> ;
    org:hasSubOrganization <https://opendata.swiss/id/organization/ch-kt-zh-v-am> ;
    foaf:homepage <https://www.zh.ch/de/volkswirtschaftsdirektion.html> ;
    foaf:name "Volkswirtschaftsdirektion (ZH)"@de .

