@prefix dcat: <http://www.w3.org/ns/dcat#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix org: <http://www.w3.org/ns/org#> .
@prefix schema1: <http://schema.org/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix vcard: <http://www.w3.org/2006/vcard/ns#> .

<https://opendata.swiss/id/organization/fl> a org:Organization,
        foaf:Organization ;
    dcterms:identifier "FL" ;
    schema1:image <https://input-backend.i14y.c.bfs.admin.ch/api/Media/logo_liechtenstein.jpg> ;
    skos:prefLabel "FL (ZH)"@de,
        "FL (ZH)"@en,
        "FL (ZH)"@fr,
        "FL (ZH)"@it ;
    dcat:contactPoint [ a vcard:Organization ;
            vcard:hasEmail <mailto:info@www.llv.li> ] ;
    org:classification <https://register.ld.admin.ch/i14y/concept/legalForm/0220> ;
    org:hasSubOrganization <https://opendata.swiss/id/organization/fl-finanzmarkt>,
        <https://opendata.swiss/id/organization/fl-geo>,
        <https://opendata.swiss/id/organization/fl-stat> ;
    foaf:homepage <https://www.llv.li/de> ;
    foaf:name "Fürstentum Liechtenstein"@de,
        "Fürstentum Liechtenstein"@en,
        "Fürstentum Liechtenstein"@fr,
        "Fürstentum Liechtenstein"@it .

<https://www.llv.li/de> a foaf:Document .

