@prefix dcat: <http://www.w3.org/ns/dcat#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix org: <http://www.w3.org/ns/org#> .
@prefix schema1: <http://schema.org/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix vcard: <http://www.w3.org/2006/vcard/ns#> .

<https://opendata.swiss/id/organization/ch-kt-zh-jus-gemeinden> a org:Organization,
        foaf:Organization ;
    dcterms:description "Das Gemeindeamt des Kantons Zürich hilft den Gemeinden, sich in Übereinstimmung mit dem kantonalen Recht zu organisieren. Mit dem Finanzausgleich stellt das Amt sicher, dass alle Gemeinden ihre Grundaufgaben erfüllen können. Daneben obliegen dem Gemeindeamt die kantonalen Aufgaben des Zivilstands-, Einbürgerungs- und Einwohnerwesens. Schliesslich ist das Gemeindeamt Aufsichtsstelle 2. Instanz (nach den Bezirksräten) hinsichtlich Organisation, Haushaltführung, Rechnungslegung sowie Aufsichtsbehörde über die Kindes- und Erwachsenenschutzbehörden."@de ;
    dcterms:identifier "CH_KT_ZH_JUS_GEMEINDEN" ;
    dcterms:spatial "ZH" ;
    schema1:identifier "CHE289794986" ;
    schema1:image <https://input-backend.i14y.c.bfs.admin.ch/api/Media/logo_kt_zh.png> ;
    skos:prefLabel "Gemeindeamt (ZH)"@de ;
    dcat:contactPoint [ a vcard:Organization ;
            vcard:hasAddress "Wilhelmstrasse 10, 8005, Zürich, ZH"@de,
                "Wilhelmstrasse 10, 8005, Zürich, ZH"@en,
                "Wilhelmstrasse 10, 8005, Zürich, ZH"@fr,
                "Wilhelmstrasse 10, 8005, Zürich, ZH"@it ;
            vcard:hasEmail <mailto:kontakt.gaz@ji.zh.ch> ] ;
    org:classification <https://register.ld.admin.ch/i14y/concept/legalForm/0221> ;
    org:subOrganizationOf <https://opendata.swiss/id/organization/ch-kt-zh-dji> ;
    foaf:homepage <https://www.zh.ch/gaz> ;
    foaf:name "Gemeindeamt (ZH)"@de .

<https://www.zh.ch/gaz> a foaf:Document .

