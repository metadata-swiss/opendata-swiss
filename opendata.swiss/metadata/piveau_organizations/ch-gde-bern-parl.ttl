@prefix dcat: <http://www.w3.org/ns/dcat#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix org: <http://www.w3.org/ns/org#> .
@prefix schema1: <http://schema.org/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix vcard: <http://www.w3.org/2006/vcard/ns#> .

<https://opendata.swiss/id/organization/ch-gde-bern-parl> a org:Organization,
        foaf:Organization ;
    dcterms:description "Das Stadtberner Parlament setzt Recht, entscheidet über das Budget und weitere bedeutende Ausgaben, beaufsichtigt den Gemeinderat und die Verwaltung und ist Wahlorgan für bestimmte Gremien."@de ;
    dcterms:identifier "CH_GDE_BERN_PARL" ;
    dcterms:spatial "Bern" ;
    schema1:image <https://input-backend.i14y.c.bfs.admin.ch/api/Media/logo_stadt_bern.jpg> ;
    skos:prefLabel "Parlamentsdienste Stadt Bern"@de,
        "Secrétariat du parlement de la ville de Berne"@fr ;
    dcat:contactPoint [ a vcard:Organization ;
            vcard:hasAddress "Predigergasse 12, 3011, Bern, BE"@de,
                "Predigergasse 12, 3011, Bern, BE"@en,
                "Predigergasse 12, 3011, Bern, BE"@fr,
                "Predigergasse 12, 3011, Bern, BE"@it ;
            vcard:hasEmail <mailto:parlamentsdienste@bern.ch> ] ;
    org:classification <https://register.ld.admin.ch/i14y/concept/legalForm/0223> ;
    foaf:homepage <https://stadtrat.bern.ch> ;
    foaf:name "Parlamentsdienste der Stadt Bern"@de,
        "Secrétariat du parlement de la ville de Berne"@fr .

<https://stadtrat.bern.ch> a foaf:Document .

