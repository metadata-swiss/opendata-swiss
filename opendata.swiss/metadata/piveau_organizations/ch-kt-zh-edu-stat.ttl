@prefix vcard: <http://www.w3.org/2006/vcard/ns#> .

<https://opendata.swiss/id/organization/ch-kt-zh-edu-stat> a org:Organization,
        foaf:Organization ;
    dcterms:description "Die Bildungsstatistik (BISTA) ist eine Abteilung der Bildungsplanung und damit ein Teil des Generalsekretariates der Bildungsdirektion Kanton Zürich. Sie hat den gesetzlichen Auftrag, statistische Daten aus dem Schulbereich zu erheben, auszuwerten und benutzergerecht aufzubereiten. Da die Bildungsstatistik Daten von öffentlichem Interesse erhebt, sind sie der Öffentlichkeit zugänglich."@de ;
    dcterms:identifier "CH_KT_ZH_EDU_STAT" ;
    dcterms:spatial "ZH" ;
    schema1:image <https://input-backend.i14y.c.bfs.admin.ch/api/Media/logo_kt_zh.png> ;
    skos:prefLabel "Bildungsstatistik Kanton Zürich"@de ;
    dcat:contactPoint [ a vcard:Organization ;
            vcard:hasEmail <mailto:bildungsplanung@bi.zh.ch> ] ;
    org:classification <https://register.ld.admin.ch/i14y/concept/legalForm/0220> ;
    org:subOrganizationOf <https://opendata.swiss/id/organization/ch-kt-zh-edu> ;
    foaf:homepage <https://www.zh.ch/de/bildungsdirektion.html> ;
    foaf:name "Bildungsstatistik Kanton Zürich"@de .

<https://www.zh.ch/de/bildungsdirektion.html> a foaf:Document .

