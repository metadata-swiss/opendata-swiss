<https://opendata.swiss/id/organization/ch-kt-zh-v-am> a org:Organization,
        foaf:Organization ;
    dcterms:description "Wir gestalten und steuern die Verkehrsentwicklung im Kanton Zürich und legen Wert darauf, dass diese nachhaltig ist. Dazu übernehmen wir die strategische Planung für alle Verkehrsmittel und wahren die Interessen des Kantons gegenüber dem Bund."@de ;
    dcterms:identifier "CH_KT_ZH_V_AM" ;
    dcterms:spatial "ZH" ;
    schema1:image <https://input-backend.i14y.c.bfs.admin.ch/api/Media/logo_kt_zh.png> ;
    skos:prefLabel "Amt für Mobilität (ZH)"@de ;
    dcat:contactPoint [ a vcard:Organization ;
            vcard:hasAddress "ZH"@de,
                "ZH"@en,
                "ZH"@fr,
                "ZH"@it ;
            vcard:hasEmail <mailto:afm@vd.zh.ch> ;
            vcard:hasTelephone "+41432593061" ] ;
    org:classification <https://register.ld.admin.ch/i14y/concept/legalForm/0221> ;
    org:subOrganizationOf <https://opendata.swiss/id/organization/ch-kt-zh-v> ;
    foaf:homepage <https://www.zh.ch/de/volkswirtschaftsdirektion/amt-fuer-mobilitaet.html> ;
    foaf:name "Amt für Mobilität (ZH)"@de .

