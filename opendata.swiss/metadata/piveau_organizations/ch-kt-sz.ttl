@prefix vcard: <http://www.w3.org/2006/vcard/ns#> .

<https://opendata.swiss/id/organization/ch-kt-sz> a org:Organization,
        foaf:Organization ;
    dcterms:identifier "CH_KT_SZ" ;
    dcterms:spatial "SZ" ;
    schema1:identifier "CHE114965128" ;
    schema1:image <https://input-backend.i14y.c.bfs.admin.ch/api/Media/logo_sz.png> ;
    skos:prefLabel "SZ"@de,
        "SZ"@en,
        "SZ"@fr,
        "SZ"@it ;
    dcat:contactPoint [ a vcard:Organization ;
            vcard:hasAddress "Bahnhofstrasse 9, 6430, Schwyz, SZ"@de,
                "Bahnhofstrasse 9, 6430, Schwyz, SZ"@en,
                "Bahnhofstrasse 9, 6430, Schwyz, SZ"@fr,
                "Bahnhofstrasse 9, 6430, Schwyz, SZ"@it ;
            vcard:hasEmail <mailto:info@sz.ch> ] ;
    org:classification <https://register.ld.admin.ch/i14y/concept/legalForm/0221> ;
    org:hasSubOrganization <https://opendata.swiss/id/organization/ch-kt-sz-umwelt-geo> ;
    foaf:homepage <https://sz.ch> ;
