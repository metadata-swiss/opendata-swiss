<https://opendata.swiss/id/organization/ch-gde-morges> a org:Organization,
        foaf:Organization ;
    dcterms:description "Die von der Stadt Morges erstellten offenen Datensätze sind über diese Website zugänglich."@de,
        "The open data sets produced by the City of Morges are accessible via this website."@en,
        "Les jeux de données ouvertes produits par la Ville de Morges sont accessibles via le présent site Internet."@fr,
        "I set di dati aperti prodotti dalla Città di Morges sono accessibili tramite questo sito web."@it ;
    dcterms:identifier "CH_GDE_MORGES" ;
    dcterms:spatial "Morges" ;
    schema1:identifier "CHE115146788" ;
    schema1:image <https://input-backend.i14y.c.bfs.admin.ch/api/Media/logo_morges_2.png> ;
    skos:prefLabel "Morges"@de,
        "Morges"@en,
        "Morges"@fr,
        "Morges"@it ;
    dcat:contactPoint [ a vcard:Organization ;
            vcard:hasAddress "Place de l'Hôtel-de-Ville 1, 1110, Morges, VD"@de,
                "Place de l'Hôtel-de-Ville 1, 1110, Morges, VD"@en,
                "Place de l'Hôtel-de-Ville 1, 1110, Morges, VD"@fr,
                "Place de l'Hôtel-de-Ville 1, 1110, Morges, VD"@it ;
            vcard:hasEmail <mailto:info@morges.ch> ] ;
