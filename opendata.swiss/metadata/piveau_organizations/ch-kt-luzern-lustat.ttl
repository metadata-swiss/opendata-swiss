<https://opendata.swiss/id/organization/ch-kt-luzern-lustat> a org:Organization,
        foaf:Organization ;
    dcterms:description "Regionale statistische Informationen für den Kanton Luzern zu allen Bereichen der öffentlichen Statistik auf Kantons-, Regions- und Gemeindestufe."@de ;
    dcterms:identifier "CH_KT_LUZERN_LUSTAT" ;
    dcterms:spatial "LU" ;
    schema1:identifier "CHE112399560" ;
    schema1:image <https://input-backend.i14y.c.bfs.admin.ch/api/Media/luzern_logo.png> ;
    skos:prefLabel "Lustat (LU)"@de,
        "Lustat (LU)"@en,
        "Lustat (LU)"@fr,
        "Lustat (LU)"@it ;
    dcat:contactPoint [ a vcard:Organization ;
            vcard:hasAddress "Burgerstrasse 22, 6002, Luzern, LU"@de,
                "Burgerstrasse 22, 6002, Luzern, LU"@en,
                "Burgerstrasse 22, 6002, Luzern, LU"@fr,
                "Burgerstrasse 22, 6002, Luzern, LU"@it ;
            vcard:hasEmail <mailto:info@lustat.ch> ;
            vcard:hasTelephone "+41 41 228 56 35" ] ;
    org:classification <https://register.ld.admin.ch/i14y/concept/legalForm/0221> ;
    org:subOrganizationOf <https://opendata.swiss/id/organization/ch-kt-luzern-fd> ;
    foaf:homepage <https://lustat.ch> ;
    foaf:name "Lustat Statistik Luzern (LU)"@de .

