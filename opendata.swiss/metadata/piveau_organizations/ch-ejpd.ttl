        "DFGP"@it ;
    dcat:contactPoint [ a vcard:Organization ;
            vcard:hasAddress "Schwanengasse 2, 3011, Bern, BE"@de,
                "Schwanengasse 2, 3011, Bern, BE"@en,
                "Schwanengasse 2, 3011, Bern, BE"@fr,
                "Schwanengasse 2, 3011, Bern, BE"@it ;
            vcard:hasEmail <mailto:info@gs-ejpd.admin.ch> ] ;
    org:classification <https://register.ld.admin.ch/i14y/concept/legalForm/0220> ;
    org:hasSubOrganization <https://opendata.swiss/id/organization/ch-bj>,
        <https://opendata.swiss/id/organization/ch-ejpd-isc>,
