@prefix dcat: <http://www.w3.org/ns/dcat#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix org: <http://www.w3.org/ns/org#> .
@prefix schema1: <http://schema.org/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix vcard: <http://www.w3.org/2006/vcard/ns#> .

<https://opendata.swiss/id/organization/ch-kt-be-weu> a org:Organization,
        foaf:Organization ;
    dcterms:identifier "CH_KT_BE_WEU" ;
    dcterms:spatial "BE" ;
    schema1:image <https://input-backend.i14y.c.bfs.admin.ch/api/Media/Kanton_Bern_RGB.jpg> ;
    skos:prefLabel "WEU (BE)"@de,
        "DEEE (BE)"@fr ;
    dcat:contactPoint [ a vcard:Organization ;
            vcard:hasAddress "Münsterplatz 3a, 3011, Bern, BE"@de,
                "Münsterplatz 3a, 3011, Bern, BE"@en,
                "Münsterplatz 3a, 3011, Bern, BE"@fr,
                "Münsterplatz 3a, 3011, Bern, BE"@it ;
            vcard:hasEmail <mailto:info.weu@be.ch> ] ;
    org:classification <https://register.ld.admin.ch/i14y/concept/legalForm/0221> ;
    foaf:name "Wirtschafts-, Energie- & Umweltdirektion (BE)"@de,
        "Direction de l'économie, de l'énergie et et de l'environnement (BE)"@fr .

