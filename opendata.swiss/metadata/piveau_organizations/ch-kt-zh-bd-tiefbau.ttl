@prefix vcard: <http://www.w3.org/2006/vcard/ns#> .

<https://opendata.swiss/id/organization/ch-kt-zh-bd-tiefbau> a org:Organization,
        foaf:Organization ;
    dcterms:description "Das Tiefbauamt plant, projektiert, realisiert und unterhält die Zürcher Staatsstrassen. Zudem betreibt es im Auftrag des Bundesamts für Strassen ASTRA die Nationalstrassen in der Gebietseinheit VII. Um den Verkehrsfluss und die Sicherheit zu optimieren, stellt es Steuerungs- und Regelungssysteme zur Verfügung. Weiter ist es für den Vollzug und die Überwachung der Umweltschutzgesetzgebung im Bereich Lärm zuständig."@de ;
    dcterms:identifier "CH_KT_ZH_BD_TIEFBAU" ;
    dcterms:spatial "ZH" ;
    schema1:identifier "CHE115992783" ;
    schema1:image <https://input-backend.i14y.c.bfs.admin.ch/api/Media/tba_zh_logo.png> ;
    skos:prefLabel "Tiefbauamt (ZH)"@de ;
    dcat:contactPoint [ a vcard:Organization ;
            vcard:hasAddress "Walcheplatz 2, 8090, Zürich, ZH"@de,
                "Walcheplatz 2, 8090, Zürich, ZH"@en,
                "Walcheplatz 2, 8090, Zürich, ZH"@fr,
                "Walcheplatz 2, 8090, Zürich, ZH"@it ;
            vcard:hasEmail <mailto:tba.strassen@bd.zh.ch> ;
            vcard:hasTelephone "+41 43 259 31 51" ] ;
    org:classification <https://register.ld.admin.ch/i14y/concept/legalForm/0221> ;
    org:subOrganizationOf <https://opendata.swiss/id/organization/ch-kt-zh-bd> ;
    foaf:homepage <https://www.zh.ch/de/baudirektion/tiefbauamt.html> ;
    foaf:name "Tiefbauamt (ZH)"@de .

<https://www.zh.ch/de/baudirektion/tiefbauamt.html> a foaf:Document .

