@prefix dcat: <http://www.w3.org/ns/dcat#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix org: <http://www.w3.org/ns/org#> .
@prefix schema1: <http://schema.org/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix vcard: <http://www.w3.org/2006/vcard/ns#> .

<https://opendata.swiss/id/organization/ch-kt-be-bkd> a org:Organization,
        foaf:Organization ;
    dcterms:identifier "CH_KT_BE_BKD" ;
    dcterms:spatial "BE" ;
    schema1:image <https://input-backend.i14y.c.bfs.admin.ch/api/Media/Kanton_Bern_RGB.jpg> ;
    skos:prefLabel "BKD (BE)"@de,
        "INC (BE)"@fr ;
    dcat:contactPoint [ a vcard:Organization ;
            vcard:hasAddress "Sulgeneckstrasse 70, 3005, Bern, BE"@de,
                "Sulgeneckstrasse 70, 3005, Bern, BE"@en,
                "Sulgeneckstrasse 70, 3005, Bern, BE"@fr,
                "Sulgeneckstrasse 70, 3005, Bern, BE"@it ;
            vcard:hasEmail <mailto:gs.bkd@be.ch> ] ;
    org:classification <https://register.ld.admin.ch/i14y/concept/legalForm/0221> ;
    foaf:name "Bildungs- und Kulturdirektion (BE)"@de,
        "Direction de l'Instruction publique et de la culture (BE)"@fr .

