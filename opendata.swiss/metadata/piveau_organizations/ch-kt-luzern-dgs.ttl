@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix vcard: <http://www.w3.org/2006/vcard/ns#> .

<https://opendata.swiss/id/organization/ch-kt-luzern-dgs> a org:Organization,
        foaf:Organization ;
    dcterms:identifier "CH_KT_LUZERN_DGS" ;
    dcterms:spatial "LU" ;
    schema1:image <https://input-backend.i14y.c.bfs.admin.ch/api/Media/luzern_logo.png> ;
    skos:prefLabel "DGS (LU)"@de ;
    dcat:contactPoint [ a vcard:Organization ;
            vcard:hasAddress "Meyerstrasse 20, 6002, Luzern, LU"@de,
                "Meyerstrasse 20, 6002, Luzern, LU"@en,
                "Meyerstrasse 20, 6002, Luzern, LU"@fr,
                "Meyerstrasse 20, 6002, Luzern, LU"@it ;
            vcard:hasEmail <mailto:gesundheit@lu.ch> ;
            vcard:hasTelephone "+41 41 228 60 90" ] ;
    org:classification <https://register.ld.admin.ch/i14y/concept/legalForm/0221> ;
    org:subOrganizationOf <https://opendata.swiss/id/organization/ch-kt-luzern-gsd> ;
    foaf:homepage <http://www.gesundheit.lu.ch> ;
    foaf:name " Dienststelle Gesundheit und Sport (LU)"@de .

