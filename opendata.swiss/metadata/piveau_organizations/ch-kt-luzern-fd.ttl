@prefix dcat: <http://www.w3.org/ns/dcat#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix org: <http://www.w3.org/ns/org#> .
@prefix schema1: <http://schema.org/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix vcard: <http://www.w3.org/2006/vcard/ns#> .

<https://opendata.swiss/id/organization/ch-kt-luzern-fd> a org:Organization,
        foaf:Organization ;
    dcterms:description "Finanzdepartement - Kanton Luzern"@de ;
    dcterms:identifier "CH_KT_LUZERN_FD" ;
    dcterms:spatial "LU" ;
    schema1:image <https://input-backend.i14y.c.bfs.admin.ch/api/Media/luzern_logo.png> ;
    skos:prefLabel "FD (LU)"@de ;
    dcat:contactPoint [ a vcard:Organization ;
            vcard:hasAddress "Bahnhofstrasse 19, 6002, Luzern, LU"@de,
                "Bahnhofstrasse 19, 6002, Luzern, LU"@en,
                "Bahnhofstrasse 19, 6002, Luzern, LU"@fr,
                "Bahnhofstrasse 19, 6002, Luzern, LU"@it ;
            vcard:hasEmail <mailto:info.fd@lu.ch> ;
            vcard:hasTelephone "+41 41 228 55 47" ] ;
    org:classification <https://register.ld.admin.ch/i14y/concept/legalForm/0221> ;
    org:hasSubOrganization <https://opendata.swiss/id/organization/ch-kt-luzern-fd-steuern>,
        <https://opendata.swiss/id/organization/ch-kt-luzern-finanzen>,
        <https://opendata.swiss/id/organization/ch-kt-luzern-immobilien>,
        <https://opendata.swiss/id/organization/ch-kt-luzern-lustat> ;
    org:subOrganizationOf <https://opendata.swiss/id/organization/ch-kt-luzern> ;
    foaf:name "Finanzdepartement (LU)"@de .

