@prefix vcard: <http://www.w3.org/2006/vcard/ns#> .

<https://opendata.swiss/id/organization/ch-kt-zh-edu> a org:Organization,
        foaf:Organization ;
    dcterms:description "Die Bildungsdirektion setzt sich dafür ein, dass den Menschen im Kanton Zürich ein vielfältiges und attraktives Bildungsangebot zur Verfügung steht."@de ;
    dcterms:identifier "CH_KT_ZH_EDU" ;
    dcterms:spatial "ZH" ;
    schema1:image <https://input-backend.i14y.c.bfs.admin.ch/api/Media/logo_kt_zh.png> ;
    skos:prefLabel "Bildungsdirektion (ZH)"@de ;
    dcat:contactPoint [ a vcard:Organization ;
            vcard:hasAddress "ZH"@de,
                "ZH"@en,
                "ZH"@fr,
                "ZH"@it ;
            vcard:hasEmail <mailto:info@bi.zh.ch> ;
            vcard:hasTelephone "+41432592309" ] ;
    org:classification <https://register.ld.admin.ch/i14y/concept/legalForm/0221> ;
    org:hasSubOrganization <https://opendata.swiss/id/organization/ch-kt-zh-bildung-volksschule>,
        <https://opendata.swiss/id/organization/ch-kt-zh-edu-stat> ;
    foaf:homepage <https://www.zh.ch/bi> ;
    foaf:name "Bildungsdirektion (ZH)"@de .

<https://www.zh.ch/bi> a foaf:Document .

