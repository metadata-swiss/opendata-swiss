@prefix dcat: <http://www.w3.org/ns/dcat#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix org: <http://www.w3.org/ns/org#> .
@prefix schema1: <http://schema.org/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix vcard: <http://www.w3.org/2006/vcard/ns#> .

<https://opendata.swiss/id/organization/ch-elcom> a org:Organization,
        foaf:Organization ;
    dcterms:identifier "CH_ELCOM" ;
    dcterms:spatial "CH" ;
    schema1:identifier "CHE190383170" ;
    schema1:image <https://input-backend.i14y.c.bfs.admin.ch/api/Media/logo_ch.png> ;
    skos:prefLabel "ElCom"@de,
        "ElCom"@en,
        "ElCom"@fr,
        "ElCom"@it ;
    dcat:contactPoint [ a vcard:Organization ;
            vcard:hasAddress "Christoffelgasse 5, 3011 Bern, BE"@de,
                "Christoffelgasse 5, 3011 Bern, BE"@en,
                "Christoffelgasse 5, 3011 Bern, BE"@fr,
                "Christoffelgasse 5, 3011 Bern, BE"@it ;
            vcard:hasEmail <mailto:info@elcom.admin.ch> ;
            vcard:hasTelephone "+41 58 462 58 33" ] ;
    org:classification <https://register.ld.admin.ch/i14y/concept/legalForm/0220> ;
    org:subOrganizationOf <https://opendata.swiss/id/organization/ch-uvek> ;
    foaf:homepage <https://www.elcom.admin.ch/> ;
    foaf:name "Eidgenössische Elektrizitätskommission (ElCom)"@de,
        "Federal Electricity Commission (ElCom)"@en,
        "Commission fédérale de l'électricité (ElCom)"@fr,
        "Commissione federale dell'energia elettrica (ElCom)"@it .

<https://www.elcom.admin.ch/> a foaf:Document .

