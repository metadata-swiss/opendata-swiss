@prefix vcard: <http://www.w3.org/2006/vcard/ns#> .

<https://opendata.swiss/id/organization/ch-kt-ur-geo> a org:Organization,
        foaf:Organization ;
    dcterms:description "Die Lisag AG bewirtschaftet das geografische Informationssystem des Kantons Uri (GIS Uri), ist die verantwortliche Stelle für den ÖREB-Kataster Uri und zudem zuständig für die Durchführung der amtlichen Vermessung auf Urner Kantonsgebiet."@de ;
    dcterms:identifier "CH_KT_UR_GEO" ;
    skos:prefLabel "Geoinformation (UR)"@de ;
    dcat:contactPoint [ a vcard:Organization ;
            vcard:hasEmail <mailto:info@ur.ch> ] ;
    foaf:homepage <https://www.ur.ch/raumumwelt/1340> ;
    foaf:name "Geoinformation (UR)"@de .

