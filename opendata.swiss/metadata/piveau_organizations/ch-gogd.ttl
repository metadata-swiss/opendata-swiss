        "OGD"@fr,
        "OGD"@it ;
    dcat:contactPoint [ a vcard:Organization ;
            vcard:hasAddress "Espace de l'Europe 10, 2010 Neuchâtel, NE"@de,
                "Espace de l'Europe 10, 2010 Neuchâtel, NE"@en,
                "Espace de l'Europe 10, 2010 Neuchâtel, NE"@fr,
                "Espace de l'Europe 10, 2010 Neuchâtel, NE"@it,
                "Espace de l'Europe 10, 2010 Neuchâtel, NE"@rm ;
            vcard:hasEmail <mailto:opendata@bfs.admin.ch> ] ;
    org:classification <https://register.ld.admin.ch/i14y/concept/legalForm/0220> ;
    org:subOrganizationOf <https://opendata.swiss/id/organization/ch1> ;
    foaf:homepage <https://www.bfs.admin.ch/bfs/de/home/dienstleistungen/ogd/geschaeftsstelle.html> ;
