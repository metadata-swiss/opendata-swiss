<https://opendata.swiss/id/organization/ch-health-ukbb> a org:Organization,
        foaf:Organization ;
    dcterms:description "Im UKBB stehen Kinder und ihre Familien im Mittelpunkt – kompetent und menschlich betreut, vom Notfall bis zur Spezialsprechstunde."@de,
        "At UKBB, children and their families are the centre of attention - competently and humanely cared for, from emergencies to special consultations."@en,
        "À l'UKBB, les enfants et leurs familles sont au centre de l'attention, avec une prise en charge compétente et humaine, des urgences aux consultations spécialisées."@fr,
        "All'UKBB, i bambini e le loro famiglie sono al centro dell'attenzione, assistiti con competenza e umanità, dalle emergenze alle consulenze speciali."@it ;
    dcterms:identifier "CH_HEALTH_UKBB" ;
    dcterms:spatial "BL",
        "BS" ;
    schema1:identifier "CHE112453018" ;
    schema1:image <https://input-backend.i14y.c.bfs.admin.ch/api/Media/logo_ukbb.png> ;
    skos:prefLabel "UKBB (BS/BL)"@de,
        "UKBB (BS/BL)"@en,
        "UKBB (BS/BL)"@fr,
        "UKBB (BS/BL)"@it ;
    dcat:contactPoint [ a vcard:Organization ;
            vcard:hasAddress "Spitalstr. 33, 4056, Basel, BS"@de,
                "Spitalstr. 33, 4056, Basel, BS"@en,
                "Spitalstr. 33, 4056, Basel, BS"@fr,
                "Spitalstr. 33, 4056, Basel, BS"@it ;
            vcard:hasEmail <mailto:info@ukbb.ch> ;
            vcard:hasTelephone "+41 61 704 12 12" ] ;
