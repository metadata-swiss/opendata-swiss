                "Monbijoustrasse 118, 3007, Bern, BE"@en,
                "Monbijoustrasse 118, 3007, Bern, BE"@fr,
                "Monbijoustrasse 118, 3007, Bern, BE"@it ;
            vcard:hasEmail <mailto:finstat@efv.admin.ch> ] ;
    org:classification <https://register.ld.admin.ch/i14y/concept/legalForm/0220> ;
    foaf:homepage <https://www.efv.admin.ch/de/was-ist-die-finanzstatistik> ;
