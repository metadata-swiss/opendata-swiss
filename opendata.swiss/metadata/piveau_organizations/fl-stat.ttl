@prefix dcat: <http://www.w3.org/ns/dcat#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix org: <http://www.w3.org/ns/org#> .
@prefix schema1: <http://schema.org/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix vcard: <http://www.w3.org/2006/vcard/ns#> .

<https://opendata.swiss/id/organization/fl-stat> a org:Organization,
        foaf:Organization ;
    dcterms:identifier "FL_STAT" ;
    dcterms:spatial "FL" ;
    schema1:image <https://input-backend.i14y.c.bfs.admin.ch/api/Media/logo_liechtenstein.jpg> ;
    skos:prefLabel "FL_STAT (ZH)"@de,
        "FL_STAT (ZH)"@en,
        "FL_STAT (ZH)"@fr,
        "FL_STAT (ZH)"@it ;
    dcat:contactPoint [ a vcard:Organization ;
            vcard:hasAddress " Äulestrasse 51,  9490, Vaduz, FL"@de,
                " Äulestrasse 51,  9490, Vaduz, FL"@en,
                " Äulestrasse 51,  9490, Vaduz, FL"@fr,
                " Äulestrasse 51,  9490, Vaduz, FL"@it ;
            vcard:hasEmail <mailto:info.as@llv.li> ;
            vcard:hasTelephone "+423 236 68 76" ] ;
    org:classification <https://register.ld.admin.ch/i14y/concept/legalForm/0220> ;
    org:subOrganizationOf <https://opendata.swiss/id/organization/fl> ;
    foaf:name "Amt für Statistik (FL)"@de,
        "Amt für Statistik (FL)"@en,
        "Amt für Statistik (FL)"@fr,
        "Amt für Statistik (FL)"@it .

