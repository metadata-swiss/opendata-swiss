@prefix dcat: <http://www.w3.org/ns/dcat#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix org: <http://www.w3.org/ns/org#> .
@prefix schema1: <http://schema.org/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix vcard: <http://www.w3.org/2006/vcard/ns#> .

<https://opendata.swiss/id/organization/ch-kt-be-gsi> a org:Organization,
        foaf:Organization ;
    dcterms:identifier "CH_KT_BE_GSI" ;
    dcterms:spatial "BE" ;
    schema1:identifier "CHE348605545" ;
    schema1:image <https://input-backend.i14y.c.bfs.admin.ch/api/Media/Kanton_Bern_RGB.jpg> ;
    skos:prefLabel "DSSI (BE)"@de,
        "GSI (BE)"@fr ;
    dcat:contactPoint [ a vcard:Organization ;
            vcard:hasAddress "Rathausplatz 1, 3000, Bern, BE"@de,
                "Rathausplatz 1, 3000, Bern, BE"@en,
                "Rathausplatz 1, 3000, Bern, BE"@fr,
                "Rathausplatz 1, 3000, Bern, BE"@it ;
            vcard:hasEmail <mailto:info.gsi@be.ch> ] ;
    org:classification <https://register.ld.admin.ch/i14y/concept/legalForm/0221> ;
    foaf:name "Gesundheits-, Sozial- und Integrationsdirektion (BE)"@de,
        "Direction de la santé, des affaires sociales et de l’intégration (BE)"@fr .

