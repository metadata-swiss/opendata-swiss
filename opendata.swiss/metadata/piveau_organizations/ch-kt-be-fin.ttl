@prefix dcat: <http://www.w3.org/ns/dcat#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix org: <http://www.w3.org/ns/org#> .
@prefix schema1: <http://schema.org/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix vcard: <http://www.w3.org/2006/vcard/ns#> .

<https://opendata.swiss/id/organization/ch-kt-be-fin> a org:Organization,
        foaf:Organization ;
    dcterms:description "Die Finanzdirektion ist innerhalb der kantonalen Verwaltung das Kompetenzzentrum auf dem Gebiet des Finanzhaushalts, des Personalwesens, des Steuerwesens sowie der Informatik und Organisation."@de,
        "Au sein de l'administration cantonale, la Direction des finances est le centre de compétences dans les domaines des finances publiques, des ressources humaines, de la fiscalité, ainsi que de l'informatique et de l'organisation."@fr ;
    dcterms:identifier "CH_KT_BE_FIN" ;
    dcterms:spatial "BE" ;
    schema1:image <https://input-backend.i14y.c.bfs.admin.ch/api/Media/Kanton_Bern_RGB.jpg> ;
    skos:prefLabel "FIN (BE)"@de,
        "FIN (BE)"@fr ;
    dcat:contactPoint [ a vcard:Organization ;
            vcard:hasAddress "Münsterplatz 12, 3011, Bern, BE"@de,
                "Münsterplatz 12, 3011, Bern, BE"@en,
                "Münsterplatz 12, 3011, Bern, BE"@fr,
                "Münsterplatz 12, 3011, Bern, BE"@it ;
            vcard:hasEmail <mailto:info.fin@be.ch> ] ;
    org:classification <https://register.ld.admin.ch/i14y/concept/legalForm/0221> ;
    foaf:homepage <https://www.be.ch/fin> ;
    foaf:name "Finanzdirektion (BE)"@de,
        "Direction des finances (BE)"@fr .

<https://www.be.ch/fin> a foaf:Document .

