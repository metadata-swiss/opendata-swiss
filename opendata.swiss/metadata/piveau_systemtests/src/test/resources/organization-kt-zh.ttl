@prefix foaf:    <http://xmlns.com/foaf/0.1/> .
@prefix org:     <http://www.w3.org/ns/org#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix schema: <http://schema.org/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix vcard: <http://www.w3.org/2006/vcard/ns#> .
@prefix dcat: <http://www.w3.org/ns/dcat#> .

[]  a foaf:Organization, org:Organization ;

  dcterms:identifier "CH_KT_ZH" ;     # I14Y ID
  schema:identifier "CHE114809327" ;  # UID
  dcterms:spatial "ZH" ;

  org:classification <https://register.ld.admin.ch/i14y/concept/legalForm/0221> ;

  foaf:name           "Kanton Zürich"@de , "%s"@en ;
  skos:prefLabel      "ZH"@de, "ZH"@en, "ZH"@fr, "ZH"@it ;
  dcterms:description "Der Kanton Zürich veröffentlicht offene Behördendaten ..."@de ;
  dcterms:description "The Canton of Zurich publishes Open Government Data ..."@en ;
  foaf:homepage       <https://www.zh.ch/opendata> ;
  schema:image        <https://storage.googleapis.com/dx-liip/production/storage/uploads/group/kt_zh.png> ;

  dcat:contactPoint [
    a vcard:Organization ;
    vcard:hasAddress "Neumuehlequai 10, 8001, Zurich, ZH"@de,
        "Neumuehlequai 10, 8001, Zurich, ZH"@en,
        "Neumuehlequai 10, 8001, Zurich, ZH"@fr,
        "Neumuehlequai 10, 8001, Zurich, ZH"@it ;
    vcard:hasEmail <mailto:info@zh.ch> ;
    vcard:hasTelephone "+41 99 888 77 66"
  ] .

<https://www.zh.ch/opendata> a foaf:Document .